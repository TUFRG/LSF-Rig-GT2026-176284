FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "(p|rho)"
    {
        solver          		GAMG;
        smoother			symGaussSeidel;
        tolerance       		1e-08;
        relTol          		0.1;
    }

    "(p|rho)Final"
    {
        $p;
        relTol		0;
		minIter		1;
    }

    "(U|k|epsilon|omega|e|h|nuTilda)"
    {
        solver		PBiCGStab;
        preconditioner	DILU;
        tolerance       1e-08;
        relTol          0.0;
		minIter		1;
    }

    "(U|k|epsilon|omega|e|h|nuTilda)Final"
    {
        $e;
        relTol          0;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 3;
    consistent	yes;

    residualControl
    {
        p               1e-5;
        U               1e-5;
        nuTilda         1e-5;
        omega		1e-5;
        k		1e-5;
    }
}

relaxationFactors
{
    fields
    {
        p               	1; //0.5;//1; DROPPED DOWN TO 0.5 AS PER MEETING 03/03/2025
    }
    equations
    {
        U               	0.9; //0.9;
        "(k|epsilon|omega|nuTilda)"	0.9;
        "(e|h)"           	0.9; //0.9;
    }
}


