nacPosC #eval{$nacZ - ($nacLengZc/2)}; // positioning of fine refinement zone C to center on testSection

lengYb #eval{$lengY + 0.2}; // fine refinement B Y-Length Refinment Reach
lengYc #eval{$lengYb + 0.4}; // fine refinement B Y-Length Refinment Reach

lengXb #eval{$lengX + 0.2}; // fine refinement B X-Length Refinment Reach
