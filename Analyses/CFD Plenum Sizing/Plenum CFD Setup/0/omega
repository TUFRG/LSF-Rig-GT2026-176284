FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

/*
Length Scale (l): use 7% of inlet height
EX: 0.14m inlet height
l = 0.07*0.112 = 0.00784

Model Coeffiecnet (Cu) = 0.09 for k-E and k-w turbulence models

w= (Cu^-0.25)*(k^(0.5))/l
w= (0.09^-0.25)*(2.34375^(0.5))/0.00784 = 356.52
*/

internalField   uniform 356.52; // from https://www.cfd-online.com/Wiki/Turbulence_free-stream_boundary_conditions
										// OpenFOAM is set up like Fluent, and the equation is (0.09^-0.25)*k^(0.5)/l

										// where l is calculated exactly the way you did

boundaryField
{
    outlet
    {
        type            zeroGradient; // same advice as for k
    }

    inlet
    {
        type            fixedValue; // again, could use a length-scale based boundary condition, but fixedValue is OK here
        value           $internalField;
    }

    casing
    {
        type            omegaWallFunction; // wall function is always needed
        blended         true;
        value           uniform 1.0e-8; // near-wall value should be small but nonzero
    }

    frontHex
    {
        type            omegaWallFunction; // wall function is always needed
        blended         true;
        value           uniform 1.0e-8; // near-wall value should be small but nonzero
    }
	
	hub
    {
        type            omegaWallFunction;
        blended         true;
        value           uniform 1.0e-8;
    }
	
    outflowPipe
    {
        type            omegaWallFunction;
        blended         true;
        value           uniform 1.0e-8;
    }

    rearHex
    {
        type            omegaWallFunction;
        blended         true;
        value           uniform 1.0e-8;
    }
    	
    topHex
    {
        type            omegaWallFunction;
        blended         true;
        value           uniform 1.0e-8;
    }
	
    wallsA
    {
        type            symmetry;
    }

}


