    yPlus
    {
        type            yPlus;
        libs            ( fieldFunctionObjects );
        writeFields     yes;
        executeControl  writeTime;
        writeControl    writeTime;
	}
	
	totalP
	{
        type                    exprField;
        libs                    (fieldFunctionObjects);
        field                   totalP;
        expression              "p + 0.5*(mag(U)*mag(U))";
        dimensions              [0 2 -2 0 0 0 0];
        writeControl    timeStep;
        writeInterval   $intvl;
    }
  
    

  	MassAvgInlets
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        enabled         yes;
        writeControl    timeStep;
        writeInterval	$intvl;
        log             yes;
        writeFields     yes;
        surfaceFormat   raw;
        regionType      patch;
        names           (
				redistEast
				redistNorth
			);
        operation       weightedAverage;
        weightField     phi;
        fields
        (
	    totalP
	    p
            U
        );
    }

