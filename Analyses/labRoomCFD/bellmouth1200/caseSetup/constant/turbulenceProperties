FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      turbulenceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

simulationType          RAS;

RAS
{
    turbulence      on;
    RASModel        realizableKE; //kOmegaSST; // needs to be yplus of <= 5 ~ all walls need to be fixed value of 0
    printCoeffs     on;
}


