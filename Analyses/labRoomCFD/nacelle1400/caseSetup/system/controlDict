FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

libs (turbulenceModelSchemes);

application     	simpleFoam;

startFrom       	latestTime;

startTime       	0;

stopAt          	endTime; 

endTime         	5000;  

deltaT          	1; //1e-07; 

writeControl    	runTime;

writeInterval   	100;

purgeWrite      	2;

writeFormat     	binary;

writePrecision  	10;

writeCompression 	off;

timeFormat      	general;

timePrecision   	8;

runTimeModifiable 	true;

//adjustTimeStep  	yes;

//maxCo			1;

intvl			100; //250;

